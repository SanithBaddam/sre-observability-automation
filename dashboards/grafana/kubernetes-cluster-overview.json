{
  "title": "Kubernetes Cluster Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["kubernetes","sre","platform"],
  "time": {"from":"now-6h","to":"now"},
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {"type":"prometheus","uid":"prometheus"},
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ready Nodes",
      "gridPos": {"h":4,"w":6,"x":0,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})"}]
    },
    {
      "type": "stat",
      "title": "Running Pods",
      "gridPos": {"h":4,"w":6,"x":6,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum(kube_pod_status_phase{phase=\"Running\",namespace=~\"$namespace\"})"}]
    },
    {
      "type": "stat",
      "title": "Pending Pods",
      "gridPos": {"h":4,"w":6,"x":12,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum(kube_pod_status_phase{phase=\"Pending\",namespace=~\"$namespace\"})"}]
    },
    {
      "type": "stat",
      "title": "Pod Restarts (1h)",
      "gridPos": {"h":4,"w":6,"x":18,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[1h]))"}]
    },
    {
      "type": "timeseries",
      "title": "Cluster CPU Usage",
      "gridPos": {"h":8,"w":12,"x":0,"y":4},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {"legendFormat":"CPU cores","expr":"sum(rate(container_cpu_usage_seconds_total{container!=\"\",image!=\"\"}[5m]))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster Memory Working Set",
      "gridPos": {"h":8,"w":12,"x":12,"y":4},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {"legendFormat":"Memory","expr":"sum(container_memory_working_set_bytes{container!=\"\",image!=\"\"})"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod Restart Rate by Namespace",
      "gridPos": {"h":8,"w":12,"x":0,"y":12},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {"legendFormat":"{{namespace}}","expr":"sum by (namespace) (rate(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[5m]))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending Pods by Namespace",
      "gridPos": {"h":8,"w":12,"x":12,"y":12},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {"legendFormat":"{{namespace}}","expr":"sum by (namespace) (kube_pod_status_phase{phase=\"Pending\",namespace=~\"$namespace\"})"}
      ]
    }
  ]
}
